# =============================================================================
# Yeezy Loyalty Platform - Environment Configuration
# Copy this file to .env and fill in your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Cloud Database (REQUIRED)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# -----------------------------------------------------------------------------
# Redis / Upstash (REQUIRED for production scaling)
# Get these from: https://console.upstash.com/redis
# For local development, you can use: redis://localhost:6379
# -----------------------------------------------------------------------------
REDIS_URL=rediss://your-upstash-endpoint.upstash.io:6379
REDIS_TOKEN=your_upstash_rest_token_here

# Alternative: Standard Redis URL (if not using Upstash)
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Production / Port Configuration
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=production

# Frontend URL for CORS (comma-separated for multiple)
FRONTEND_URL=https://your-frontend.vercel.app
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# -----------------------------------------------------------------------------
# JWT Authentication (REQUIRED - Change in production!)
# Generate a secure secret: openssl rand -base64 32
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars-change-in-production
JWT_EXPIRY=24h

# -----------------------------------------------------------------------------
# Graceful Shutdown
# -----------------------------------------------------------------------------
SHUTDOWN_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Meta WhatsApp Business Cloud API (Server-side Webhook & Dispatch)
# Get these from: https://developers.facebook.com/apps/
# -----------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here

# -----------------------------------------------------------------------------
# Petpooja POS Integration
# Get these from Petpooja dashboard
# -----------------------------------------------------------------------------
# PETPOOJA_API_KEY=your_petpooja_api_key
# PETPOOJA_SECRET_KEY=your_petpooja_secret_key

# -----------------------------------------------------------------------------
# Reelo Integration (Optional)
# -----------------------------------------------------------------------------
# REELO_API_KEY=your_reelo_api_key
# REELO_WEBHOOK_SECRET=your_reelo_webhook_secret

# -----------------------------------------------------------------------------
# SMTP / Email (Optional)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# SMS / OTP (Optional)
# -----------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# ENABLE_WHATSAPP=true
# ENABLE_PETPOOJA=true
# ENABLE_REELO=false
# ENABLE_MARKETPLACE=true