# Yeezy Loyalty Platform - Production Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://yeezy-loyalty.onrender.com

# =============================================================================
# SUPABASE DATABASE (Required for production)
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# =============================================================================
# POS WEBHOOK SECRETS (Generate unique secrets per POS system)
# =============================================================================
# Petpooja webhook secret - configure in Petpooja dashboard
PETPOOJA_WEBHOOK_SECRET=your_petpooja_webhook_secret_here

# RMS webhook secret - configure in RMS admin panel
RMS_WEBHOOK_SECRET=your_rms_webhook_secret_here

# Toast API credentials (when available)
TOAST_CLIENT_ID=your_toast_client_id
TOAST_CLIENT_SECRET=your_toast_client_secret

# Square API credentials (when available)
SQUARE_ACCESS_TOKEN=your_square_access_token

# =============================================================================
# LOYALTY PLATFORM SETTINGS
# =============================================================================
# URL for POS systems to connect to (used by RMS PlatformLoyaltyProvider)
LOYALTY_PLATFORM_URL=https://yeezy-loyalty.onrender.com

# RMS webhook secret for inbound webhooks from RMS POS
RMS_WEBHOOK_SECRET=your_rms_webhook_secret_here

# =============================================================================
# NOTIFICATION SETTINGS (Optional - for WhatsApp, SMS, Email)
# =============================================================================
# Twilio (SMS/WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_WHATSAPP_NUMBER=+15551234567

# SendGrid (Email)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=loyalty@yeezy-loyalty.com
SENDGRID_FROM_NAME=Yeezy Loyalty

# =============================================================================
# RATE LIMITING & SECURITY
# =============================================================================
# API rate limits (requests per minute)
API_RATE_LIMIT=100
API_RATE_LIMIT_BURST=200

# Webhook rate limits
WEBHOOK_RATE_LIMIT=30
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://yeezy-loyalty.onrender.com,https://dashboard.yeezy-loyalty.com

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# Sentry (error tracking)
SENTRY_DSN=your_sentry_dsn

# Prometheus metrics endpoint (already at /metrics)
METRICS_ENABLED=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_MARKETPLACE=true
ENABLE_MULTI_OUTLET=true
ENABLE_REFERRALS=true
ENABLE_WINBACK=true
ENABLE_MULTIPLIER_RULES=true

# =============================================================================
# INTEGRATION SETTINGS
# =============================================================================
# Default loyalty program config (JSON)
DEFAULT_LOYALTY_CONFIG='{
  "point_value_paise": 100,
  "earn": {
    "base_rate_bps": 500,
    "eligible_amount": "subtotal_after_discount_excl_tax_and_service_charge",
    "big_bill": { "enabled": true, "threshold_paise": 50000, "bonus_points": 25 },
    "streak": { "enabled": true, "within_days": 7, "bonus_points": 10 },
    "bonus_points_expiry_days": 30,
    "points_expiry_days": 90
  },
  "tiers": [
    { "name": "Silver", "min_visits": 0, "multiplier": 1.0 },
    { "name": "Gold", "min_visits": 5, "multiplier": 1.25 },
    { "name": "Platinum", "min_visits": 12, "multiplier": 1.5 }
  ],
  "redeem": {
    "min_points": 50,
    "min_bill_paise": 30000,
    "max_percent_of_bill": 20,
    "stackable_with_discounts": false,
    "allowed_order_types": ["dine_in", "takeaway"]
  },
  "referral": {
    "enabled": true,
    "referrer_points": 50,
    "referee_points": 50,
    "qualify_min_first_bill_paise": 30000,
    "max_referrals_per_month": 10
  },
  "winback": {
    "enabled": true,
    "inactive_days": 21,
    "multiplier": 2.0,
    "valid_days": 7
  },
  "guardrail": {
    "max_effective_earn_rate_bps": 800
  }
}'

# =============================================================================
# DEVELOPMENT OVERRIDES (Only for local development)
# =============================================================================
# Uncomment for local development without Supabase
# USE_IN_MEMORY_STORE=true