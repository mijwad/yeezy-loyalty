// bee.loyalty - Prisma Schema
// Restaurant Loyalty Platform with Petpooja Integration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE MODELS
// ============================================

model Restaurant {
  id            String    @id @default(cuid())
  name          String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  outlets       Outlet[]
  loyaltyConfigs LoyaltyConfig[]
}

model Outlet {
  id                    String    @id @default(cuid())
  restaurantId          String
  restaurant            Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name                  String
  address               String?
  contactInfo           String?
  // Petpooja integration fields
  eateryBranchCode      String    @unique // Petpooja's branch code (tenant key)
  restID                String?     // Petpooja's restaurant ID (stored but not used as key)
  posSystem             String    @default("PETPOOJA")
  ignoreAggregators     Boolean   @default(true) // Skip earning for Zomato/Swiggy orders
  otpRequired           Boolean   @default(false)
  pointValuePaise       Int       @default(100) // 1 point = ₹1 (100 paise)
  earnBase              EarnBase  @default(CORE_MINUS_DISCOUNT) // How to calculate earn base
  minBillPaise          Int       @default(0)
  minPoints             Int       @default(1)
  maxRedeemPercent      Int       @default(100) // Max % of bill that can be redeemed
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  customers     Customer[]
  orders        Order[]
  rewards       Reward[]
  redemptions   Redemption[]
  webhookLogs   WebhookLog[]

  @@index([eateryBranchCode])
  @@index([restaurantId])
}

enum EarnBase {
  CORE_TOTAL
  TOTAL
  CORE_MINUS_DISCOUNT
}

// Loyalty configuration per restaurant (can override outlet defaults)
model LoyaltyConfig {
  id                String    @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  key               String
  value             String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([restaurantId, key])
}

model Customer {
  id          String   @id @default(cuid())
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  phone       String   // Normalized: digits only, no +91, no spaces, no leading zeros
  name        String?
  address     String?
  loyaltyCode String?  // Petpooja's loyaltyCode/coupon code
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pointsLedger PointsLedger[]
  redemptions  Redemption[]
  orders       Order[]

  @@unique([outletId, phone])
  @@index([phone])
}

// Points ledger - immutable transaction log (source of truth)
model PointsLedger {
  id              String           @id @default(cuid())
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  outletId        String
  type            PointsLedgerType
  points          Int              // Positive for earn, negative for burn
  balanceAfter    Int              // Running balance for easy queries
  description     String?
  referenceType   String?          // "ORDER", "REDEMPTION", "EXPIRY", "ADJUSTMENT", "REVERSAL"
  referenceId     String?          // orderID, redemptionId, etc.
  idempotencyKey  String?          // For deduplication (outletId:orderID)
  metadata        Json?
  createdAt       DateTime         @default(now())

  @@index([customerId, createdAt])
  @@index([outletId, createdAt])
  @@index([idempotencyKey])
  @@index([referenceType, referenceId])
}

enum PointsLedgerType {
  EARN
  BURN
  EXPIRY
  ADJUSTMENT
  REVERSAL
  RESERVE // Temporary hold for redemption
  RELEASE // Release of reserve
}

model Order {
  id                String   @id @default(cuid())
  outletId          String
  outlet            Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  posOrderId        String   // Petpooja's orderID
  invoiceNo         String?  // Petpooja's invoice_no (for redemption linking)
  orderType         String   // Dine In, Delivery, Pick Up
  paymentType       String   // Card, Cash, Wallet, Online, Credit, Other
  coreTotalPaise    Int      // Core total in paise
  totalPaise        Int      // Total in paise
  discountTotalPaise Int     @default(0)
  taxTotalPaise     Int      @default(0)
  orderFrom         String?  // POS, Zomato, Swiggy, etc.
  orderJson         Json     // Full Petpooja payload for audit
  earnedPoints      Int      @default(0)
  status            OrderStatus @default(PENDING)
  settledAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([outletId, posOrderId])
  @@index([invoiceNo])
  @@index([customerId])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING
  SETTLED
  SKIPPED_LOYALTY
  NEEDS_REVIEW
}

// Rewards catalog (what customers can redeem)
model Reward {
  id              String       @id @default(cuid())
  outletId        String
  outlet          Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  discountType    DiscountType // 1=Percentage, 2=Fixed, 3=Free Item
  pointsCost      Int          // Points required
  discountValue   Int?         // For percentage: percentage value (e.g., 10 for 10%), for fixed: amount in paise
  posItemId       String?      // Petpooja's pos_item_id for free items
  minBillPaise    Int          @default(0)
  maxRedemptions  Int?         // Per customer per period
  isActive        Boolean      @default(true)
  validFrom       DateTime?
  validUntil      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  redemptions Redemption[]

  @@index([outletId, isActive])
}

enum DiscountType {
  PERCENTAGE // 1
  FIXED      // 2
  FREE_ITEM  // 3
}

model Redemption {
  id                String           @id @default(cuid())
  outletId          String
  outlet            Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rewardId          String?
  reward            Reward?          @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  invoiceNo         String           // Petpooja's invoice_no
  posOrderId        String?          // Linked order's posOrderId (set at settle)
  pointsBurned      Int              // Points deducted
  discountAmountPaise Int            // Actual discount given in paise
  status            RedemptionStatus @default(HELD)
  reservationId     String?          // Points reservation reference
  expiresAt         DateTime         // When hold expires
  settledAt         DateTime?
  needsReview       Boolean          @default(false)
  reviewReason      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([outletId, invoiceNo])
  @@index([customerId, status])
  @@index([outletId, posOrderId])
  @@index([expiresAt])
}

enum RedemptionStatus {
  HELD        // Reserved, waiting for order
  SETTLED     // Linked to order, completed
  CANCELLED   // Cancelled before settle
  EXPIRED_RELEASED // Hold expired, points released
  NEEDS_REVIEW // Settle failed or expired at settle time
}

// Webhook logs for debugging
model WebhookLog {
  id          String   @id @default(cuid())
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  endpoint    String   // saveOrder, getRewards, redeem, verifyOtp
  requestBody Json     // Redacted (token masked, phone masked)
  responseBody Json    // Redacted
  statusCode  Int
  latencyMs   Int
  success     Boolean
  errorMessage String?
  createdAt   DateTime @default(now())

  @@index([outletId, createdAt])
  @@index([endpoint, success])
  @@index([createdAt])
}

// Partner tokens (Petpooja gets one token)
model PartnerToken {
  id          String   @id @default(cuid())
  name        String   // e.g., "Petpooja"
  tokenHash   String   // SHA256 hash of the token
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  @@index([tokenHash])
}